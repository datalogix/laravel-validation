{
    "name": "datalogix/laravel-validation",
    "description": "Laravel Validation is a package that brings the power of Respect Validation.",
    "keywords": [
        "laravel",
        "validation",
        "respect",
        "rules"
    ],
    "homepage": "https://github.com/datalogix/laravel-validation",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ricardo Gobbo de Souza",
            "email": "ricardogobbosouza@yahoo.com.br"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "respect/validation": "^2.5"
    },
    "require-dev": {
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "ext-bcmath": "Required to use the iban rule",
        "ext-fileinfo": "Required to use the image and mimetype rules",
        "giggsey/libphonenumber-for-php-lite": "Required to use the phone rule with a country code"
    },
    "autoload": {
        "psr-4": {
            "Datalogix\\Validation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datalogix\\Validation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "@php vendor/bin/pint",
        "lint": [
            "@php vendor/bin/pint --test",
            "@php vendor/bin/phpstan analyse"
        ],
        "test": "@php vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Datalogix\\Validation\\ValidationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
